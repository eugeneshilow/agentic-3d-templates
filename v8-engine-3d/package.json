    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.169.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  }
}
